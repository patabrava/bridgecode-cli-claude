{
  "name": "@patabrava/bridgecode-cli-claude",
  "version": "4.3.2",
  "description": "Install, update, and verify Bridgecode repo-local instructions for Claude Code (Claude Code edition).",
  "type": "module",
  "bin": {
    "bridgecode-claude": "bin/bridgecode-claude.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "payload-manifest.json",
    "bin/",
    "src/",
    "payload/",
    "hooks/"
  ],
  "scripts": {
    "build:manifest": "node scripts/build-manifest.mjs",
    "prepack": "npm run build:manifest",
    "test": "node --test test/lifecycle.test.mjs test/safety.test.mjs test/hooks.test.mjs test/policy.test.mjs",
    "test:tarball": "node --test test/tarball.test.mjs",
    "sync:payload": "node scripts/sync-payload.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "keywords": [
    "claude-code",
    "claude",
    "CLAUDE.md",
    "bridgecode",
    "agent",
    "instructions",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patabrava/bridgecode-cli-claude.git"
  },
  "bugs": {
    "url": "https://github.com/patabrava/bridgecode-cli-claude/issues"
  },
  "homepage": "https://github.com/patabrava/bridgecode-cli-claude#readme"
}
